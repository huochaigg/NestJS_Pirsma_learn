# DATABASE_URL 示例。复制为 .env 后改成你自己的账号密码。
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://用户名:密码@localhost:3306/nest_prisma_learning"

# V15 Guard 学习用 API Key。Swagger 测试 protected-demo 时在 Header 填同样的值。
LEARNING_API_KEY="nestjs-v15-secret"

# V18 JWT 签名密钥。必须足够长的随机串，不要用 secret 这类弱默认值，也不要提交真实生产密钥。
JWT_SECRET="请换成足够长的随机字符串"

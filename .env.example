# .env.example：告诉其他开发者项目需要哪些环境变量，可以提交 Git。
# 复制为 .env 后填入当前机器的真实值。.env 才是本机配置，通常不提交。
# replace-me 只是占位，不是可用密钥。

PORT=3000
DATABASE_URL=mysql://user:password@localhost:3306/database
JWT_SECRET=replace-me-with-at-least-32-chars-secret
JWT_EXPIRES_IN=1h
LEARNING_API_KEY=replace-me
NODE_ENV=development

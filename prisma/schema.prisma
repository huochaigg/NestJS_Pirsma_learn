// schema.prisma：Prisma 的数据模型描述文件。
// 它本身不是数据库，只是 Prisma 层的“图纸”。
// 数据库结构链：schema.prisma → prisma migrate dev → migration SQL → MySQL 表
// Client 生成链：schema.prisma → prisma generate → src/generated/prisma → PrismaClient

generator client {
  // generator client：根据 schema 生成 TypeScript 可使用的 Prisma Client。
  // 它不会创建数据库表；建表是 migrate 的工作。
  provider = "prisma-client"
  // output：生成代码放在哪里。业务代码之后从这里 import PrismaClient。
  output   = "../src/generated/prisma"
  // moduleFormat = "cjs"：当前 NestJS 项目是 CommonJS，生成 CJS Client 才能直接运行。
  moduleFormat = "cjs"
}

datasource db {
  // datasource：描述 Prisma 要连接什么数据库。
  // provider = "mysql" 表示数据库类型是 MySQL。
  // 连接账号密码不写在 schema 里，由 prisma.config.ts 读取环境变量 DATABASE_URL。
  provider = "mysql"
}

// model User：定义 User 数据模型。
// 这是 Prisma 层的模型，不是数据库本身；执行 migrate 后才会变成 MySQL 里的 User 表。
model User {
  // @id：主键。
  // @default(autoincrement())：由数据库生成自增主键。
  id        Int      @id @default(autoincrement())
  name      String
  // @unique：唯一约束，同一张表里 email 不能重复。
  email     String   @unique
  // ?：可空字段，age 可以不填。
  age       Int?
  // @default(now())：创建记录时默认写入当前时间。
  createdAt DateTime @default(now())
  // @updatedAt：更新记录时 Prisma 自动维护更新时间。
  updatedAt DateTime @updatedAt
  // orders Order[]：Prisma 关系字段（relation field），表示一个 User 可以有多个 Order。
  // 这是 Prisma 层对“一对多”的描述，用来做关系查询和类型提示。
  // MySQL 的 User 表里不会多出一列 orders，更不会存 JSON 数组。
  orders    Order[]
}

// model Order：订单数据模型。一个 Order 只属于一个 User，多个 Order 可以指向同一个 User。
// 这是一对多（1:N）：User 是 1，Order 是 N。数据库靠 Order.userId 外键实现，User 表不保存 orderIds。
model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique
  // amount 用 Int，学习阶段先避免 Decimal 的精度/类型转换问题。
  amount    Int
  status    String   @default("pending")
  // userId：scalar field，真正存在 MySQL Order 表里的外键列。
  // 例如 userId = 3 表示这个订单属于 User.id = 3。关系：Order.userId → User.id。
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // user：Prisma relation field，表示当前 Order 关联的那一个 User。
  // 它通常不是数据库里的额外列；真正存盘的是上面的 userId。
  // @relation：声明外键怎么连。
  // fields: [userId] → 当前表用哪个字段存外键。
  // references: [id] → 这个外键指向 User 的哪个字段。
  // 以后还可以配 onDelete/onUpdate（Cascade、Restrict、SetNull），V9 不实现，保持默认安全行为。
  user      User     @relation(fields: [userId], references: [id])

  // V13：一个 Order 只对应一个 Product，方便把事务学明白。
  // 真实电商一般是 Order + OrderItem（一单多商品），这里先不做。
  quantity  Int      @default(1)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
}

// Product：最小库存模型。stock 表示当前可卖数量。
model Product {
  id        Int      @id @default(autoincrement())
  name      String
  sku       String   @unique
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  logs      InventoryLog[]
}

// InventoryLog：库存流水。change 正数表示入库，负数表示出库。
model InventoryLog {
  id        Int      @id @default(autoincrement())
  productId Int
  change    Int
  type      String
  remark    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
